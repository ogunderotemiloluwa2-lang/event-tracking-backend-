# Backend environment variables.
# Copy to ".env" locally, or set each of these in the Render dashboard
# (Environment > Environment Variables). NEVER commit the real .env.

# --- MongoDB ---
# Use your Atlas SRV string in production (Render's DNS resolves SRV fine):
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/event_tracking?retryWrites=true&w=majority

# --- Server ---
# Render sets PORT automatically; the app reads process.env.PORT.
PORT=5000
NODE_ENV=production

# --- JWT Authentication ---
# MUST be at least 32 characters or the server refuses to start.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# --- Google Drive Service Account (NOT USED) ---
# Photos are stored in each organizer's own Drive via the OAuth credentials
# below. This variable is only read by utils/googleDriveServiceAccount.js,
# which is not imported anywhere. Leave it unset.
# GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Google OAuth (REQUIRED for photo upload + gallery) ---
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# GOOGLE_REDIRECT_URI points at THIS BACKEND, not the frontend, and must
# include the /api/v1 prefix. Add the same URL to the OAuth client's
# "Authorised redirect URIs" in Google Cloud Console or you get
# redirect_uri_mismatch.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/auth/google-callback

# --- Cloudinary (NOT USED) ---
# Only read by utils/cloudinaryUpload.js, which is not imported anywhere.
# Leave these unset.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Email Service (Gmail app password, not your normal password) ---
# Used by the event-reminder endpoints only. Password reset does NOT send
# email yet (see routes/auth.js /forgot-password) — it will move to Brevo.
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: CORS_ORIGINS=https://your-frontend.vercel.app,https://admin.yourapp.com
CORS_ORIGINS=https://your-frontend.vercel.app

# --- CSRF ---
# No CSRF token is required: authentication uses a Bearer JWT sent in the
# Authorization header (never a cookie), so browsers cannot attach credentials
# to cross-site requests automatically. If cookie-based auth is ever introduced,
# add a CSRF token middleware (e.g. csurf) at the same time.
